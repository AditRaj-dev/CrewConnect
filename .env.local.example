# NEXT_PUBLIC_APK_DOWNLOAD_URL: set this to the current release asset URL (bump version each release),
# or use the GitHub latest pattern if your APK filename is stable.
# Example latest pattern: https://github.com/AditRaj-dev/CrewConnect/releases/latest/download/CrewConnect.apk
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://github.com/AditRaj-dev/CrewConnect/releases/download/{VERSION}/CrewConnect.v{VERSION}.apk
NEXT_PUBLIC_MIN_ANDROID_VERSION=8.0
NEXT_PUBLIC_WEB_APP_URL=https://your-app.vercel.app/
